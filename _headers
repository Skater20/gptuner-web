# Cabeceras de seguridad de todo el sitio (mismo criterio que las demás webs). El sitio no
# usa JavaScript propio ni de terceros, así que la CSP puede ser estricta de verdad.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
