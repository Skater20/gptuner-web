# Site-wide security headers. script-src 'self' only allows our OWN i18n.js/i18n-data.js
# (no inline scripts, no eval, no third-party script host). No inline style="" remains anywhere
# in the HTML, so style-src needs no 'unsafe-inline' either.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
